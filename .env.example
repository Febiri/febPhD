# ==========================================
# febPhD / Zotero Audio Mentor - Environment Template
# ==========================================

# 1. Google Gemini API (Free Tier)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Zotero Web API Integration (Optional)
# Find User ID at: https://www.zotero.org/settings/keys
# Generate API Key with library read access at: https://www.zotero.org/settings/keys/new
ZOTERO_LIBRARY_ID=your_zotero_user_id_here
ZOTERO_API_KEY=your_zotero_api_key_here
ZOTERO_LIBRARY_TYPE=user

# 3. Text-to-Speech Voice (Free Microsoft Edge Neural TTS)
# Options:
# en-NG-AbeoNeural (Male, West African / Ghanaian Accent - Natural & Expressive)
# en-NG-EzinneNeural (Female, West African / Ghanaian Accent - Melodic & Clear)
# en-KE-ChilembaNeural (Male, East African / Kenyan Accent - Scholarly)
# en-ZA-LukeNeural (Male, South African Accent - Crisp & Modern)
# en-US-ChristopherNeural (Male, Authoritative US Mentor)
# en-GB-RyanNeural (Male, British Academic)
DEFAULT_TTS_VOICE=en-NG-AbeoNeural

# 4. Database
DATABASE_URL=sqlite:///./zotero_audio.db
